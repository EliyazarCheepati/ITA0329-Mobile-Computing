16.Free-Space Path Loss and Received Power
Aim: To calculate Free-Space Path Loss (FSPL) and received power for different distances and frequencies.
import math
import matplotlib.pyplot as plt

frequency = 2.4  # Frequency in GHz
transmit_power = 20  # Transmit power in dBm

distances = [1, 2, 5, 10, 20, 50, 100]

fspl_values = []
received_power = []

for distance in distances:
    fspl = 92.45 + 20 * math.log10(distance) + 20 * math.log10(frequency)
    rx_power = transmit_power - fspl

    fspl_values.append(fspl)
    received_power.append(rx_power)

    print(f"Distance: {distance} km")
    print(f"FSPL: {fspl:.2f} dB")
    print(f"Received Power: {rx_power:.2f} dBm")
    print("-" * 30)

plt.plot(distances, fspl_values, marker='o')
plt.xlabel("Distance (km)")
plt.ylabel("Free-Space Path Loss (dB)")
plt.title("FSPL vs Distance")
plt.grid(True)
plt.show()

plt.plot(distances, received_power, marker='o', color='red')
plt.xlabel("Distance (km)")
plt.ylabel("Received Power (dBm)")
plt.title("Received Power vs Distance")
plt.grid(True)
plt.show()
